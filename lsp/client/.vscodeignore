# The VSIX is just the esbuild bundle plus the js65 CLI bundle; the extension is
# packaged with `--no-dependencies`, so node_modules never ships.
# `dist/extension.js` and `server/js65-node.mjs` are deliberately absent from
# this list.
.vscode/**
.vscode-test/**
out/**
dist/**/*.map
src/**
test/**
testFixture/**
scripts/**
node_modules/**
tsconfig.json
package-lock.json
**/*.ts
!types/js65-globals.d.ts
**/.gitignore
