# The VSIX is the esbuild bundle plus `server/js65.mjs`, the single-file js65
# bundle the extension forks as `js65 lsp`. Packaged with `--no-dependencies`,
# so no node_modules ships at all.
# `dist/extension.js` and `server/**` are deliberately absent from this list.
.vscode/**
.vscode-test/**
out/**
dist/**/*.map
src/**
test/**
testFixture/**
scripts/**
node_modules/**
tsconfig.json
package-lock.json
**/*.ts
!types/js65-globals.d.ts
**/.gitignore
