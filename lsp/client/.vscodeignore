# The VSIX is the esbuild bundle plus the js65 package tree under `server/`,
# which the extension forks as `js65 lsp`. Packaged with `--no-dependencies`, so
# the extension's own node_modules never ships; `server/node_modules` is the
# server's runtime deps and is copied in deliberately.
# `dist/extension.js` and `server/**` are deliberately absent from this list.
.vscode/**
.vscode-test/**
out/**
dist/**/*.map
src/**
test/**
testFixture/**
scripts/**
node_modules/**
tsconfig.json
package-lock.json
**/*.ts
!types/js65-globals.d.ts
**/.gitignore
