{
	"compilerOptions": {
		"module": "node16",
		"moduleResolution": "node16",
		"target": "ES2022",
		"lib": ["ES2022"],
		"types": ["node", "mocha"],
		"outDir": "out",
		"rootDir": "",
		"sourceMap": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true
	},
	"include": ["src", "test"],
	"exclude": ["node_modules", ".vscode-test", "server"]
}
