{
  "name": "js65",
  "version": "1.1.0-alpha.2",
  "type": "module",
  "description": "CLI and library for assembling, linking, patching, and smudging 6502 assembly code",
  "main": "./dist/src/libassembler.js",
  "types": "./dist/src/libassembler.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/libassembler.d.ts",
      "bun": "./dist/src/driver/entry-bun.js",
      "node": "./dist/src/driver/entry-node.js",
      "default": "./dist/src/driver/entry-pako.js"
    },
    "./cli": {
      "types": "./dist/src/driver/cli.d.ts",
      "default": "./dist/src/driver/cli.js"
    },
    "./node": {
      "types": "./dist/integrations/node.d.ts",
      "default": "./dist/integrations/node.js"
    },
    "./worker": {
      "types": "./dist/src/worker/handler.d.ts",
      "browser": "./dist/src/driver/entry-worker-browser.js",
      "default": "./dist/src/driver/entry-worker-node.js"
    },
    "./worker-client": {
      "types": "./dist/src/worker/client.d.ts",
      "default": "./dist/src/worker/client.js"
    }
  },
  "bin": {
    "js65": "./integrations/npm/js65.mjs"
  },
  "files": [
    "dist",
    "integrations/npm",
    "README.md",
    "LICENSE.txt",
    "LICENSE-3RD-PARTY.txt"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "./dist/src/driver/entry-*.js"
  ],
  "scripts": {
    "gen-version": "bun gen-version.ts",
    "gen-jsglobals": "bun lsp/gen-jsglobals.ts",
    "jsmodules": "bun gen-jsmodules.ts",
    "jsmodules:nomaps": "bun gen-jsmodules.ts --no-maps",
    "cli-watch": "bun --watch --inspect ./integrations/bun.ts",
    "exe": "bun run jsmodules && bun build --compile --minify --sourcemap --bytecode ./integrations/bun.ts --outfile ./build/js65-bun",
    "node": "bun run jsmodules && bun build --target=node --format=esm --outfile build/js65-node.mjs integrations/node.ts",
    "lib": "bun run jsmodules:nomaps && bun build --entrypoints ./src/driver/entry-pako.ts --outfile ./build/libassembler.js",
    "worker": "bun run jsmodules:nomaps && bun build --entrypoints ./src/driver/entry-worker-browser.ts --outfile ./build/js65-worker.js --format=esm",
    "lsp-worker": "bun run jsmodules && bun build lsp/server/worker/bin.ts --target=node --format=cjs --outfile build/js65-lsp-worker.cjs",
    "lsp": "bun run lsp-worker && bun build lsp/server/bin.ts --target=node --format=cjs --outfile build/js65-lsp.cjs",
    "test": "bun run jsmodules && bun test --only-failures ./test && bun run test:lsp",
    "test:lsp": "bun run lsp && bun test --only-failures ./lsp/server/test",
    "hermes-exe": "bun run jsmodules && bun run integrations/hermes/hermes-build.ts",
    "build": "bun run jsmodules && bun run --no-exit-on-error --parallel exe hermes-exe node",
    "bench": "bun run build && bun run bench/bench.ts",
    "profile": "bun run bench/profile.ts",
    "cpuprof": "bun run bench/cpuprof.ts",
    "verify": "bun run bench/verify.ts",
    "build:npm": "bun run jsmodules && tsc -p tsconfig.build.json",
    "prepack": "bun run jsmodules && tsc -p tsconfig.build.json",
    "typecheck": "bun run jsmodules && tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jsnesx/js65"
  },
  "author": "Stephen Hicks",
  "contributors": ["James Rowe"],
  "license": "MPL-2.0",
  "bugs": {
    "url": "https://github.com/jsnesx/js65/issues"
  },
  "homepage": "https://github.com/jsnesx/js65#readme",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "typescript-language-server": "^5.3.0"
  },
  "dependencies": {
    "pako": "^3.0.1",
    "sha1-uint8array": "^0.10.7"
  },
  "workspaces": [
    "./lsp/server",
    "./lsp/client"
  ],
  "trustedDependencies": [
    "@vscode/vsce-sign"
  ]
}
