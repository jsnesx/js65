{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "es2022",
    "target": "es2022",
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSourceMap": false,
    "inlineSources": false,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts", "integrations/node.ts"],
  "exclude": ["test/**", "tools/**", "bench/**", "src/jsmodule/*/**"]
}
